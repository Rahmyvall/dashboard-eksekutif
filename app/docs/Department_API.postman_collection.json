        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"code\": \"IT-POSTMAN\",\n    \"name\": \"Information Technology Postman\",\n    \"description\": \"Data pengujian REST API dari Postman.\",\n    \"status\": \"active\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/departments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "departments"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const json = pm.response.json();",
              "pm.test('Department berhasil dibuat', function () {",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('id');",
              "});",
              "if (json.data && json.data.id) {",
              "  pm.collectionVariables.set('department_id', json.data.id);",
              "}"
            ]
          }
        }
      ]
    },
