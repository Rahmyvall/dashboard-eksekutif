  "item": [
    {
      "name": "1. Get All Departments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "disabled": true
          }
        ],
        "url": {
          "raw": "{{base_url}}/departments?per_page=10&sort_by=name&sort_direction=asc",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "departments"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "10"
            },
            {
              "key": "sort_by",
              "value": "name"
            },
            {
              "key": "sort_direction",
              "value": "asc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response success', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
